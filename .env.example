# Copia este archivo a .env (NO se sube a Git) y rellena tus valores.
# Spring Boot no lee .env solo: define estas variables en tu terminal antes de arrancar.

# Base de datos. Local:
DB_URL=jdbc:mysql://localhost:3306/mediturno?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=mediturno
DB_PASSWORD=
# Aiven (copia host, puerto y base desde la consola de Aiven; SSL es obligatorio):
# DB_URL=jdbc:mysql://HOST:PUERTO/NOMBRE_BD?sslMode=REQUIRED&serverTimezone=UTC

# Seguridad JWT: usa un secreto propio, largo y aleatorio. Nunca el de las pruebas.
JWT_SECRET=
JWT_EXPIRATION_MS=3600000

# Opcionales
SERVER_PORT=8080
AUTH_REGISTRATION_ENABLED=true
# Origenes del frontend permitidos por CORS, separados por coma:
CORS_ALLOWED_ORIGINS=http://localhost:*